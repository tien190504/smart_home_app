# Docker deployment
TZ=UTC
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# PostgreSQL
POSTGRES_DB=iot_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_URL=jdbc:postgresql://postgres:5432/iot_backend
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT
JWT_SECRET=V2VsY29tZVRvSW9UQmFja2VuZFNlY3VyZUp3dEtleUZvckRlbW8xMjM0NTY3ODkw
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# MQTT
MQTT_ENABLED=true
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_CLIENT_ID=iot-docker-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TELEMETRY_TOPIC=iot/devices/+/telemetry
MQTT_COMMAND_TOPIC_TEMPLATE=iot/devices/%s/commands
MQTT_QOS=1
MQTT_COMPLETION_TIMEOUT=5000

# Initial admin account
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@iot.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456

# Logging
SECURITY_LOG_LEVEL=INFO
